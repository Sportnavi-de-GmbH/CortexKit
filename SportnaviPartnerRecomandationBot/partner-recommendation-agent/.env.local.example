AZURE_AI_CHATBOT_OPENAI_ENDPOINT= # Azure OpenAI resource endpoint URL
AZURE_AI_CHATBOT_API_KEY= # Azure OpenAI API key
AZURE_AI_CHATBOT_DEPLOYMENT_NAME= # Azure deployment name (default: gpt-4.1)

MEMORY_SUPABASE_URL= # Supabase project URL (server-side only)
MEMORY_SUPABASE_SERVICE_ROLE_KEY= # Supabase service role key (server-side only; RLS has no policies)

EMBEDDING_API_URL= # Embedding API base URL (must serve text-embedding-3-small, 1536-dim)
EMBEDDING_API_KEY= # Embedding API key

# --- Sentry observability (see reports/markdown/AI-Agent-Monitoring-Report.md) ---
SENTRY_DSN= # Sentry project DSN; missing DSN makes Sentry a silent no-op
SENTRY_ORG= # e.g. ncr4ailab — needed only by scripts/verify-sentry.ts
SENTRY_PROJECT= # e.g. partner-recommendation-agent — needed only by verify-sentry
SENTRY_AUTH_TOKEN= # scope event:read; lets verify-sentry PROVE events landed
SENTRY_ENVIRONMENT=development
SENTRY_RECORD_IO=false # true ships prompts/completions off-box — privacy opt-in
# SENTRY_VERCEL_AI_INTEGRATION=0 # set 0 only to re-measure native span emission
# EVE_SENTRY_SPAN_DEBUG=1 # log span names for scripts/spike measurement
# EVE_SENTRY_SPAN_LOG= # POINT OUTSIDE THE PROJECT — writing inside triggers a
#                      # next-dev recompile loop (watcher sees the log grow)

# --- LangSmith tracing (EU region; see EVE_LANGSMITH_TRACING_GUIDE.md) ---
LANGSMITH_API_KEY= # LangSmith EU API key (lsv2_pt_...); missing key makes this a silent no-op
LANGSMITH_PROJECT=sportnavi-partner-recommendationbot-development # per-environment: -staging / -production later
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com # EU region is binding — never the US default
# LANGSMITH_WORKSPACE_ID= # only needed for org-scoped API keys
LANGSMITH_RECORD_IO=false # true ships prompts/completions/system-prompt off-box — privacy opt-in
# LANGSMITH_EXPORT_ALL=true # bypass the workflow-noise span filter, for debugging trees
# EVE_LS_SPAN_DEBUG=1 # log KEEP/DROP span verdicts for scripts/spike measurement
# EVE_LS_SPAN_LOG= # POINT OUTSIDE THE PROJECT — same reason as EVE_SENTRY_SPAN_LOG above
