# ─────────────────────────────────────────────────────────────────────────────
# Convex build — environment template.
#
# Copy to `.env.local` (this project does NOT use `.env`) and fill in the
# values marked YOU MUST PROVIDE. Nothing here is invented for you; every
# blank is a real credential you have to supply.
#
#   cp .env.local.example .env.local
#
# See SETUP.md for where each value comes from.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. CONVEX  (YOU MUST PROVIDE — but `npx convex dev` writes these for you) ─
#
# Running `npx convex dev` once logs you in, creates a deployment, and appends
# CONVEX_DEPLOYMENT + NEXT_PUBLIC_CONVEX_URL to .env.local automatically.
# You normally do not type these by hand.
#
# CONVEX_DEPLOYMENT is used by the Convex CLI to know which deployment to push
# to. CONVEX_URL / NEXT_PUBLIC_CONVEX_URL is what lib/convex.ts connects to.
# The code accepts either name; `convex dev` writes the NEXT_PUBLIC_ one.

CONVEX_DEPLOYMENT=            # e.g. dev:my-deployment-123 — written by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=       # e.g. https://my-deployment-123.convex.cloud — written by `npx convex dev`
# CONVEX_URL=                 # optional alias; set this instead if you prefer a non-public name


# ── 2. AZURE OPENAI CHAT  (YOU MUST PROVIDE) ─────────────────────────────────
#
# The model that writes Navio's answers. Use the SAME deployment as the
# Supabase build or the benchmark compares two different models.

AZURE_AI_CHATBOT_OPENAI_ENDPOINT=   # Azure OpenAI resource endpoint URL
AZURE_AI_CHATBOT_API_KEY=           # Azure OpenAI API key
AZURE_AI_CHATBOT_DEPLOYMENT_NAME=   # Azure deployment name (default: gpt-4o-mini)


# ── 3. EMBEDDINGS  (YOU MUST PROVIDE) ────────────────────────────────────────
#
# Must serve `text-embedding-3-small` at 1536 dimensions. This is PINNED and
# enforced at runtime (lib/embeddings.ts): the vectors stored in Convex came
# from that model, and mixing embedding spaces corrupts similarity SILENTLY —
# scores stay plausible while the meaning is garbage.
#
# Use the SAME endpoint as the Supabase build.

EMBEDDING_API_URL=            # embedding API base URL, or a full Azure .../embeddings?api-version=... URL
EMBEDDING_API_KEY=            # embedding API key


# ── 4. SUPABASE  (YOU MUST PROVIDE — for the ONE-TIME data export only) ──────
#
# Needed ONLY by `npm run convex:export`, which reads the live directory and
# writes data/export/. The agent itself never touches Supabase; once you have
# an export directory these two can be removed.
#
# The SERVICE ROLE key is mandatory: `partners` has RLS enabled with no
# policies, so the anon key returns zero rows SILENTLY.

MEMORY_SUPABASE_URL=                # Supabase project URL (server-side only)
MEMORY_SUPABASE_SERVICE_ROLE_KEY=   # Supabase service role key (server-side only)


# ── 5. BENCHMARK  (optional) ─────────────────────────────────────────────────
#
# `npm run benchmark` drives both stacks. Point this at the Supabase build's
# directory so it can run that side in-process. Defaults to
# ../partner-recommendation-agent.

# BENCHMARK_SUPABASE_PROJECT_DIR=../partner-recommendation-agent
# BENCHMARK_ITERATIONS=5             # measured runs per case, per backend
# BENCHMARK_WARMUP=1                 # discarded warm-up runs per case, per backend


# ── 6. OBSERVABILITY  (all optional; every one is a silent no-op when unset) ─

SENTRY_DSN=                   # Sentry project DSN; missing DSN makes Sentry a silent no-op
SENTRY_ORG=                   # only needed by scripts/verify-sentry.ts
SENTRY_PROJECT=               # only needed by scripts/verify-sentry.ts
SENTRY_AUTH_TOKEN=            # scope event:read; lets verify-sentry PROVE events landed
SENTRY_ENVIRONMENT=development
SENTRY_RECORD_IO=false        # true ships prompts/completions off-box — privacy opt-in

# LangSmith tracing (EU region is binding — never the US default).
# Use a DIFFERENT project name from the Supabase build so the two sets of
# traces stay separable when you compare them.
LANGSMITH_API_KEY=            # LangSmith EU API key (lsv2_pt_...); missing key = silent no-op
LANGSMITH_PROJECT=sportnavi-partner-recommendationbot-convex-development
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=     # only needed for org-scoped API keys
LANGSMITH_RECORD_IO=false     # true ships prompts/completions/system-prompt off-box

# --- Navio proxy / service-to-service auth ----------------------------------
# Shared secret between this service and the Navio consumers:
#  - the widget's /api/partner proxy sends it as HTTP Basic ("navio-proxy":secret)
#    to /eve/v1/* (verified by agent/channels/eve.ts);
#  - forwarded feedback votes carry it as x-navio-proxy-secret on /api/feedback.
# Unset => the Basic check is skipped locally (localDev auth still applies) and
# /api/feedback accepts loopback-only. Set the SAME value in the widget and the
# orchestrator (.env.local: PARTNER_PROXY_SECRET) when enabling it.
PARTNER_PROXY_SECRET=
# PARTNER_MAX_REQUEST_BYTES=16384   # request body cap enforced by the channel

# --- Langfuse observability (Navio's observability layer; CLAUDE.md §16) -----
# Each Navio agent gets its OWN Langfuse project, chosen ONLY by the key pair
# below — nothing in the code names a project. This service must carry the
# "Navio — Partner" keys; the FAQ agent (kb-agent-langsmith-starter) carries
# "Navio — FAQ". Swapping these would silently merge the two agents' traces.
#
# Missing host or either key => every Langfuse surface is a silent no-op and
# the agent (plus Sentry and LangSmith) runs exactly as before.
LANGFUSE_BASE_URL=https://sportnavi-langfuse.sportnavi.de # self-hosted v4 instance (LANGFUSE_HOST also accepted)
LANGFUSE_PUBLIC_KEY= # project "Navio — Partner" public key (pk-lf-...)
LANGFUSE_SECRET_KEY= # project "Navio — Partner" secret key (sk-lf-...)
# Score-config + annotation-queue ids for the 👍/👎 feedback system (optional).
# Get these by running `npx tsx scripts/setup-feedback-scores.ts` — it prints
# them. Unset = feedback still works, just without configId linkage or negative
# feedback queuing for review.
LANGFUSE_FEEDBACK_SCORE_CONFIG_ID=
LANGFUSE_REASON_SCORE_CONFIG_ID=
LANGFUSE_FEEDBACK_QUEUE_ID=
LANGFUSE_TRACING_ENVIRONMENT=development # must match ^(?!langfuse)[a-z0-9-_]+$, <=40 chars — an invalid value makes Langfuse REJECT the span
LANGFUSE_RECORD_IO=false # true ships visitor text + partner names off-box — privacy opt-in
# LANGFUSE_RECORD_SYSTEM_PROMPT=true # also export the FULL instructions (needs RECORD_IO too); the digest is always recorded anyway
# LANGFUSE_TRACE_COMPLETENESS=complete # debug only: also export eve's workflow/step/fetch spans. MEASURED 14x more observations — never in production
# LANGFUSE_DEDUPE_USAGE=false # debug only: keep aggregator usage. A search makes TWO billed calls, so this bills the turn ~2x
# LANGFUSE_HUMAN_NAMES=false # debug only: keep raw framework span names
# LANGFUSE_EXPORT_ALL=true # debug only: bypass the span filter entirely
# EVE_LF_SPAN_DEBUG=1 # log KEEP/DROP span verdicts — separates "exporter never saw it" from "not ingested yet"
# EVE_LF_SPAN_LOG= # POINT OUTSIDE THE PROJECT — writing inside triggers a
#                  # next-dev recompile loop (watcher sees the log grow)
