# Copy to .env.local (gitignored). Never commit real values.

# --- Model provider (Azure OpenAI) — required for the agent to answer ---
AZURE_AI_CHATBOT_OPENAI_ENDPOINT=
AZURE_AI_CHATBOT_API_KEY=
AZURE_AI_CHATBOT_DEPLOYMENT_NAME=gpt-4.1

# --- AI Gateway routing (MVP plan, Layer 5: the hard spend cap) ---
# Set to a Vercel AI Gateway model id to route model calls through the gateway,
# which activates the hard spend cap + per-visitor cost tracking. Keep Azure EU
# as the provider behind it via BYOK (configured in the Gateway dashboard).
# Leave BLANK to call the Azure deployment directly (default; no spend cap).
#   e.g. AI_GATEWAY_MODEL=openai/gpt-4.1
AI_GATEWAY_MODEL=
# Off Vercel only: a static gateway key (on Vercel, OIDC is automatic — leave blank).
# AI_GATEWAY_API_KEY=

# --- Public widget security (MVP plan, Layers 1 & 4) ---
# Extra browser origins allowed to call /eve/v1/* IN ADDITION to this deployment's
# own origin (the iframe is same-origin, so usually leave BLANK). Comma-separated.
# Only needed if you serve the widget cross-origin.
#   e.g. WIDGET_ALLOWED_ORIGINS=https://www.sportnavi.de,https://sportnavi.de
WIDGET_ALLOWED_ORIGINS=
# Who may EMBED the widget iframe on their site — the allow-list of websites that
# are permitted to display the Navio chat window. Enforced by the browser via the
# `Content-Security-Policy: frame-ancestors` header on /widget. Any site NOT listed
# here CANNOT show the widget (the browser refuses the iframe). Space-separated origins.
#   'self'                                        = the widget's own page (always keep)
#   https://www.sportnavi.de https://sportnavi.de = the live Sportnavi site
# Add more origins to let other sites embed it (e.g. a partner site, or a local test page):
#   WIDGET_FRAME_ANCESTORS='self' https://www.sportnavi.de https://sportnavi.de http://localhost:8080
# Leave BLANK to use the built-in default, which is exactly the value below (sportnavi.de only).
WIDGET_FRAME_ANCESTORS='self' https://www.sportnavi.de https://sportnavi.de
# Bot protection (Vercel BotID). Requires the `botid` package + Vercel Pro.
# Server-side enforcement gate in agent/channels/eve.ts:
BOTID_ENABLED=false
# Client-side challenge injection in the widget page (must match the server flag):
NEXT_PUBLIC_BOTID_ENABLED=false
# Public policy links shown in the widget (consent gate, footer, contact-form consent).
# Defaults already point at the live Sportnavi pages; override only if the URLs move.
# NEXT_PUBLIC_PRIVACY_URL=https://www.sportnavi.de/datenschutz/
# NEXT_PUBLIC_WIDERRUF_URL=https://www.sportnavi.de/widerrufsbelehrung/

# --- LangSmith (EU) — you add these while following the guide (§4) ---
# Missing key = every LangSmith surface must stay a no-op. The agent still runs.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kb-agent-langsmith-starter
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Required ONLY if your API key is org-scoped (not workspace-scoped):
# LANGSMITH_WORKSPACE_ID=
# true ships full prompts and completions to LangSmith. Default private.
LANGSMITH_RECORD_IO=false

# --- Contact form (Kontaktformular → Salesforce) — SERVER-ONLY, never NEXT_PUBLIC_ ---
# Leave BOTH Salesforce credentials BLANK for SIMULATE MODE: the form works end-to-end
# and returns success without contacting Salesforce (payload logged at WARNING). Fill
# them (in Vercel env / .env.local, never committed) to create real Cases.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Non-secret Salesforce config (change per org):
SALESFORCE_TOKEN_URL=https://sportnavi.my.salesforce.com/services/oauth2/token
SALESFORCE_INSTANCE_URL=https://sportnavi.my.salesforce.com
SALESFORCE_API_VERSION=v65.0
SALESFORCE_FLOW_API_NAME=CaseHandler
SALESFORCE_TOKEN_TTL_SEC=3600
SALESFORCE_TIMEOUT_SEC=15
# Message length cap + per-IP/minute rate limit for POST /api/contact:
MAX_MESSAGE_CHARS=2000
CONTACT_RATE_LIMIT_PER_MIN=15
# Optional email fallback (used only if Salesforce fails). Not wired yet — leaving blank
# logs the payload at ERROR instead. Add `nodemailer` + these to enable email fallback.
CONTACT_FALLBACK_EMAIL=mohamed-naceur.mahmoud@sportnavi.de
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
